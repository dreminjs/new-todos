{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^types$": "<rootDir>/../../types/src",
    "^#generated/(.*)\\.js$": "<rootDir>/../generated/prisma/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
