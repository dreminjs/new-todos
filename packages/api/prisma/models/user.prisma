model User {
  id                      String                 @id @default(uuid())
  firstName               String
  lastName                String
  username                String                 @unique
  avatarUrl               String?
  createdAt               DateTime               @default(now())
  email                   String                 @unique
  hashedPassword          String
  emailConfirmed          Boolean                @default(false)
  notifcationsRoomId      String?
  chatMessages            ChatMessage[]
  notifications           Notification[]
  token                   Token?
  workspaces              Workspace[]
  workspaceInvitations    WorkspaceInvitation[]
  workspaceParticipants   WorkspaceParticipant[]
  workspaceRequests       WorkspaceRequest[]
  todoGroupParticipants   TodoGroupParticipant[]
  userForgotPasswordCode  UserForgotPasswordCode?
  todos                   Todo[]                 @relation("CreatedTodos")
  assigneeTodos           Todo[]                 @relation("AssignedTodos")
}


model UserForgotPasswordCode {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
